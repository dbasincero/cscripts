# Copie para .env e ajuste.  ->  cp .env.example .env
#
# Raiz no disco externo do Mac (APFS — ver nota no README sobre exFAT).
FORD_2TB=/Volumes/FORD_2TB/cscripts-lab

# Senha do usuario SYS/SYSTEM/PDBADMIN dos dois bancos (troque!).
ORACLE_PWD=Oracle_2026_lab

# --- Imagens (verifique a tag atual em container-registry.oracle.com) ---
# 26ai (linhagem 23ai) — imagem "Free". Em Apple Silicon ha build arm64.
IMG_26AI=container-registry.oracle.com/database/free:latest
# Alternativa comunitaria mais simples (sem login na registry da Oracle):
# IMG_26AI=gvenzl/oracle-free:latest

# 19c Enterprise — SEM build nativo ARM: roda emulado (linux/amd64).
# Requer login: docker login container-registry.oracle.com  (e aceitar os termos da imagem)
IMG_19C=container-registry.oracle.com/database/enterprise:19.3.0.0

# Portas no host
PORT_19C=1521
PORT_26AI=1522
